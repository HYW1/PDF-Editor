.editor-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f0f0;
  overflow: hidden;
}

/* Top bar */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.topbar-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.btn-back {
  font-size: 40rpx;
  padding: 8rpx 16rpx;
  color: var(--primary);
}

.file-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-icon {
  font-size: 36rpx;
  padding: 8rpx 12rpx;
  color: var(--primary);
}

.btn-icon.disabled {
  opacity: 0.3;
  pointer-events: none;
}

.btn-export {
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
}

/* Preview area */
.preview-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.preview-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.page-indicator {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  font-size: 24rpx;
  color: #999;
  background: rgba(255,255,255,0.8);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  z-index: 10;
}

.page-swiper {
  width: 100%;
  height: 100%;
}

.preview-page {
  margin: 0 auto;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
  position: relative;
  overflow: hidden;
}

.preview-canvas {
  width: 100%;
  height: 100%;
}

.annotation {
  position: absolute;
  cursor: move;
  z-index: 5;
}

.ann-image {
  width: 100%;
  height: 100%;
}

.empty-state {
  text-align: center;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* Toolbar */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid var(--border);
  flex-shrink: 0;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.tool-item:active {
  opacity: 0.6;
}

.tool-icon {
  font-size: 36rpx;
}

.tool-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* Thumbnail strip */
.thumbnail-strip {
  height: 180rpx;
  background: #fff;
  border-top: 1rpx solid var(--border);
  white-space: nowrap;
  padding: 16rpx 12rpx;
  flex-shrink: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.thumb-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: 0 8rpx;
  border: 3rpx solid transparent;
  border-radius: 8rpx;
  padding: 4rpx;
}

.thumb-item.active {
  border-color: var(--primary);
}

.thumb-page {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  border-radius: 4rpx;
  position: relative;
  overflow: hidden;
}

.thumb-canvas {
  width: 100%;
  height: 100%;
}

.thumb-rotation {
  position: absolute;
  bottom: 2rpx;
  right: 4rpx;
  font-size: 16rpx;
  color: #fff;
  background: rgba(0,0,0,0.5);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

.thumb-index {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* Add menu */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}

.add-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.add-menu.show {
  transform: translateY(0);
}

.add-menu-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.add-menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid var(--border);
}

.add-menu-item:active {
  background: #f5f5f5;
}

.add-menu-icon {
  margin-right: 20rpx;
  font-size: 36rpx;
}

.add-menu-cancel {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}
