.signature-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.sig-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 88rpx;
  background: #fff;
  border-bottom: 1rpx solid #e5e5e5;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.sig-cancel {
  font-size: 30rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.sig-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sig-confirm {
  font-size: 30rpx;
  color: #4361ee;
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.canvas-wrapper {
  flex: 1;
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.sig-canvas {
  width: 100%;
  height: 100%;
}

.sig-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 32rpx;
  color: #ddd;
  pointer-events: none;
}

.sig-actions {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.sig-btn-clear {
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #ef4444;
  background: #fff;
  border-radius: 12rpx;
}
