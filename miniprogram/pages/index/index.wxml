<view class="page">
  <view class="header">
    <view class="title">PDF小助手</view>
  </view>

  <view class="cards">
    <view class="card card-primary" bindtap="onEditPDF">
      <view class="card-icon">
        <view class="icon-edit">✎</view>
      </view>
      <view class="card-body">
        <view class="card-title">编辑 PDF</view>
        <view class="card-desc">删页、调序、旋转，加上签名和文字后导出</view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <view class="card" bindtap="onMergePDF">
      <view class="card-icon">
        <view class="icon-merge">⊞</view>
      </view>
      <view class="card-body">
        <view class="card-title">合并 PDF</view>
        <view class="card-desc">把多个文件合成一份，再调整页序</view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <view class="card" bindtap="onWebToPDF">
      <view class="card-icon">
        <view class="icon-web">⊕</view>
      </view>
      <view class="card-body">
        <view class="card-title">网页转 PDF</view>
        <view class="card-desc">把网页保存成 PDF</view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <view class="card" bindtap="onImageToPDF">
      <view class="card-icon">
        <view class="icon-web">▣</view>
      </view>
      <view class="card-body">
        <view class="card-title">图片转 PDF</view>
        <view class="card-desc">把照片做成一页一页的 PDF</view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <view class="card" bindtap="onPdfToImage">
      <view class="card-icon">
        <view class="icon-web">▤</view>
      </view>
      <view class="card-body">
        <view class="card-title">PDF 转图片</view>
        <view class="card-desc">把每一页存成 PNG 图片</view>
      </view>
      <view class="card-arrow">›</view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">文件不上传，改完再导出</text>
  </view>
</view>
