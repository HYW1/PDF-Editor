page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #1a1a1a;
  background-color: #f5f5f5;
  --primary: #4361ee;
  --primary-light: #e8ecff;
  --danger: #ef4444;
  --text: #1a1a1a;
  --text-secondary: #666;
  --text-hint: #999;
  --border: #e5e5e5;
  --bg: #f5f5f5;
  --card: #ffffff;
  --radius: 16rpx;
  --radius-sm: 8rpx;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
